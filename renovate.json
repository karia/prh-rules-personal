{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Asia/Tokyo",
  "pinDigests": true,
  "automerge": false,
  "prHourlyLimit": 0,
  "schedule": [
    "* 18-23 * * *"
  ],
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions non-major updates"
    }
  ]
}
