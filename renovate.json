{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>karia/renovate-config"
  ],
  "dependencyDashboard": true,
  "pinDigests": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions non-major updates"
    }
  ]
}
